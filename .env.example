# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration (PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@localhost:5432/adearn_db"

# Session & Security
SESSION_SECRET="your-super-secret-random-key-change-in-production"

# Advertising & CPA Network Configuration (e.g. CPAGrip)
CPAGRIP_API_KEY="your_cpagrip_api_key_here"
CPAGRIP_PUBLISHER_ID="2559473"
CPAGRIP_POSTBACK_SECRET="denish_cpagrip_secret"

# Owner Profit Margin Percentage (e.g. 70 = 70% owner profit, 30% user reward share)
OWNER_PROFIT_MARGIN_PERCENT=70

# Demo Mode (true enables simulated offers, test tracking, and mock conversions for safe testing)
DEMO_MODE=true

